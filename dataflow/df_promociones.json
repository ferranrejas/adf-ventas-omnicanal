{
	"name": "df_promociones",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "promociones_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sql_promociones",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          promocion_id as string,",
				"          nombre_promocion as string,",
				"          fecha_inicio as string,",
				"          fecha_fin as string,",
				"          porcentaje_descuento as string,",
				"          canal_aplicable as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(nombre_promocion = trim(nombre_promocion),",
				"          fecha_inicio = toDate(fecha_inicio, 'yyyy-MM-dd'),",
				"          fecha_fin = toDate(fecha_fin, 'yyyy-MM-dd'),",
				"          tipo_descuento = 'Porcentaje',",
				"          porcentaje_descuento = toDecimal(porcentaje_descuento, 8, 2),",
				"          estado_promocion = iif(fecha_fin >= fecha_inicio, 'Activa', 'Finalizada')) ~> derivedColumn1",
				"derivedColumn1 split(isNull(promocion_id) || fecha_fin < fecha_inicio,",
				"     disjoint: false) ~> split1@(rechazados, validados)",
				"split1@validados sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          promocion_id as string,",
				"          nombre_promocion as string,",
				"          tipo_descuento as string,",
				"          valor_descuento as decimal(8,2),",
				"          fecha_inicio as date,",
				"          fecha_fin as date,",
				"          canal_aplicable as string,",
				"          estado_promocion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          promocion_id,",
				"          nombre_promocion,",
				"          tipo_descuento,",
				"          valor_descuento = porcentaje_descuento,",
				"          fecha_inicio,",
				"          fecha_fin,",
				"          canal_aplicable,",
				"          estado_promocion",
				"     )) ~> sink1"
			]
		}
	}
}