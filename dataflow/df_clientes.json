{
	"name": "df_clientes",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "clientes_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sql_clientes",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          cliente_id as string,",
				"          nombre as string,",
				"          email as string,",
				"          telefono as string,",
				"          ciudad as string,",
				"          fecha_registro as string,",
				"          segmento as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(nombre = initCap(trim(nombre)),",
				"          ciudad = initCap(trim(ciudad)),",
				"          email = lower(trim(email)),",
				"          telefono = trim(telefono),",
				"          fecha_registro = toDate(fecha_registro, 'yyyy-MM-dd'),",
				"          edad = toInteger(null()),",
				"          nivel_fidelidad = toString(null())  ) ~> derivedColumn1",
				"derivedColumn1 split(isNull(cliente_id) || isNull(nombre) || isNull(email) || isNull(ciudad),",
				"     disjoint: false) ~> split1@(rechazados, validados)",
				"split1@validados sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          cliente_id as string,",
				"          nombre as string,",
				"          ciudad as string,",
				"          segmento as string,",
				"          fecha_registro as date,",
				"          edad as integer,",
				"          nivel_fidelidad as string,",
				"          email as string,",
				"          telefono as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          cliente_id,",
				"          nombre,",
				"          ciudad,",
				"          segmento,",
				"          fecha_registro,",
				"          edad,",
				"          nivel_fidelidad,",
				"          email,",
				"          telefono",
				"     )) ~> sink1"
			]
		}
	}
}